{
  "name": "toiloff-backend",
  "version": "1.0.17",
  "scripts": {
    "dev": "bun run --watch src/**/*.ts --watch src/assets/*.txt",
    "start": "NODE_ENV=production bun src/index.ts",
    "migrate": "MIGRATOR_ACTION=upgrade bun run src/migrator.ts",
    "migrate:up": "bun run migrate",
    "migrate:down": "MIGRATOR_ACTION=downgrade bun run src/migrator.ts",
    "worker:notify": "NODE_ENV=production bun run src/modules/notify/worker.ts",
    "start:cold": "bun run migrate && bun run start"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "@elysia/static": "^1.4.11",
    "@mtcute/bun": "^0.32.1",
    "@mtcute/html-parser": "^0.32.1",
    "@nirelc/microconf": "^0.0.3",
    "@opencode-ai/models": "^0.0.95",
    "altcha-lib": "^2.4.0",
    "elysia": "latest",
    "elysia-http-status-code": "^1.0.9",
    "jose": "^6.2.12",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^5.0.1",
    "lexorank": "^1.0.5"
  },
  "type": "module",
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "bun-types": "latest"
  },
  "module": "src/index.js"
}
